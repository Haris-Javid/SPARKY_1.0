#include "nrf24.h"

#define PAYLOAD_SIZE 10
uint8_t rx_addr[5] = {'D','R','O','N','E'};
uint8_t rx_buffer[PAYLOAD_SIZE];
uint8_t rx_length = PAYLOAD_SIZE;

void setup_nrf24_rx_only() {
    nRF24_SetAddrWidth(5);
    nRF24_SetRFChannel(78);
    nRF24_SetDataRate(nRF24_DR_1Mbps);
    nRF24_SetTXPower(nRF24_TXPWR_0dBm);
    nRF24_SetCRCScheme(nRF24_CRC_2byte);
    nRF24_SetAutoRetr(nRF24_ARD_1500us, 5);

    nRF24_SetRXPipe(nRF24_PIPE0, nRF24_AA_ON, PAYLOAD_SIZE);
    nRF24_SetAddr(nRF24_PIPE0, rx_addr);
    nRF24_EnableAA(nRF24_PIPE0);

    // Disable other RX pipes
    for (int pipe = nRF24_PIPE1; pipe <= nRF24_PIPE5; pipe++) {
        nRF24_DisableAA(pipe);
    }

    nRF24_SetPowerMode(nRF24_PWR_UP);
    HAL_Delay(2);

    // Switch to RX mode and set CE high to start listening
    nRF24_SetOperationalMode(nRF24_MODE_RX);
    nRF24_FlushRX();
    nRF24_ClearIRQFlags();
    nRF24_CE_H();
}

int main(void) {
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_SPI1_Init();

    setup_nrf24_rx_only();

    while(1) {
        // Check if data received
        if (nRF24_GetStatus_RXFIFO() != nRF24_STATUS_RXFIFO_EMPTY) {
            nRF24_ReadPayload(rx_buffer, &rx_length);
            nRF24_ClearIRQFlags();

            // Toggle LED on receive
            HAL_GPIO_TogglePin(RED_LED_GPIO_Port, RED_LED_Pin);

            // Optional: process rx_buffer here
        }
        HAL_Delay(10); // small delay to reduce CPU load
    }
}
