#include "main.h"
#include "nrf24.h"

/* Private variables */
SPI_HandleTypeDef hspi1;

typedef enum {
  NO_DATA,
  RX_RECEIVED
} nRF24_RX_Status;
/* Private function prototypes */

void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_SPI1_Init(void);
nRF24_RX_Status RECEIVED_DATA(uint8_t *buffer, uint8_t *length);


int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_SPI1_Init();

  // Set up nRF24 module
  uint8_t addr[5] = {'D', 'R', 'O', 'N', 'E'};
  nRF24_set_up(5, 78, nRF24_DR_1Mbps, nRF24_TXPWR_0dBm, nRF24_CRC_2byte,
              nRF24_ARD_1500us, 5, nRF24_PIPE0, addr, nRF24_AA_ON, 10);

  // Switch to RX mode
  nRF24_Switch_to_RX_mode();

  uint8_t rx_buffer[32];
  uint8_t length = 10;

  while (1)
  {
    if (RECEIVED_DATA(rx_buffer, &length) == RX_RECEIVED) {
      // Data received - toggle LED
      HAL_GPIO_TogglePin(RED_LED_GPIO_Port, RED_LED_Pin);

      // Process received data here (rx_buffer contains the received data)
      // length contains the number of bytes received
    }
    HAL_Delay(10);
  }
}

void nRF24_set_up(uint8_t width, uint8_t channel, uint8_t data_rate, uint8_t power_level,
                 uint8_t CRC_mode, uint8_t delay, uint8_t attempts, uint8_t rx_pipe,
                 uint8_t *addr, uint8_t AA_state, uint8_t payload_size)
{
    nRF24_SetAddrWidth(width);
    nRF24_SetRFChannel(channel);
    nRF24_SetDataRate(data_rate);
    nRF24_SetTXPower(power_level);
    nRF24_SetCRCScheme(CRC_mode);
    nRF24_SetAutoRetr(delay, attempts);
    nRF24_SetTXAddr(addr);
    nRF24_SetAddr(rx_pipe, addr);
    nRF24_EnableAA(rx_pipe);
    nRF24_SetRXPipe(rx_pipe, AA_state, payload_size);

    // Disable AA on other pipes
    for (uint8_t pipe = 1; pipe <= 5; pipe++) {
        nRF24_DisableAA(pipe);
    }

    nRF24_SetPowerMode(nRF24_PWR_UP);
    HAL_Delay(1);
}

void nRF24_Switch_to_RX_mode()
{
    nRF24_SetOperationalMode(nRF24_MODE_RX);
    nRF24_FlushRX();
    nRF24_CE_H();
    HAL_Delay(1);
}

nRF24_RX_Status RECEIVED_DATA(uint8_t *buffer, uint8_t *length)
{
    if (nRF24_GetStatus_RXFIFO() != nRF24_STATUS_RXFIFO_EMPTY) {
        nRF24_ReadPayload(buffer, length);
        nRF24_ClearIRQFlags();
        return RX_RECEIVED;
    }
    return NO_DATA;
}

