/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include "nrf24.h"

/* Private variables */
SPI_HandleTypeDef hspi1;
TIM_HandleTypeDef htim5;

/* Private typedef */
typedef enum {
  NO_DATA,
  RX_RECEIVED
} nRF24_RX_Status;

/* Private function prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_SPI1_Init(void);
static void MX_TIM5_Init(void);
void nRF24_set_up(uint8_t width, uint8_t channel, uint8_t data_rate, uint8_t power_level,
                 uint8_t CRC_mode, uint8_t delay, uint8_t attempts, uint8_t rx_pipe,
                 uint8_t *addr, uint8_t AA_state, uint8_t payload_size);
void nRF24_Switch_to_RX_mode(void);
nRF24_RX_Status RECEIVED_DATA(uint8_t *buffer, uint8_t *length);

/* Private variables */
volatile uint32_t count = 0;

int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_SPI1_Init();
  MX_TIM5_Init();

  // Start timer
  HAL_TIM_Base_Start_IT(&htim5);

  // Configure nRF24 module
  uint8_t addr[5] = {'D', 'R', 'O', 'N', 'E'};
  nRF24_set_up(5, 78, nRF24_DR_1Mbps, nRF24_TXPWR_0dBm, nRF24_CRC_2byte,
              nRF24_ARD_1500us, 5, nRF24_PIPE0, addr, nRF24_AA_ON, 10);

  // Switch to RX mode
  nRF24_Switch_to_RX_mode();
  nRF24_ClearIRQFlags();

  uint8_t rx_buffer[32];
  uint8_t length = 10;

  while (1)
  {
    if (RECEIVED_DATA(rx_buffer, &length) == RX_RECEIVED) {
      // Toggle LED when data is received
      HAL_GPIO_TogglePin(RED_LED_GPIO_Port, RED_LED_Pin);

      // Process received data (rx_buffer contains received data)
      // length contains number of bytes received
    }
    HAL_Delay(10);
  }
}

